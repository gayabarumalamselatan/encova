# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js build cache ───────────────────────────────────────────────────────
# We only need .next/standalone and .next/static in the final image.
# The rest of .next is build cache that bloats the context.
.next/cache/

# ── Development & editor files ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Environment & secrets (never bake these into the image) ──────────────────
.env
.env.*
!.env.example

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo

# ── Testing & CI artifacts ────────────────────────────────────────────────────
coverage/
.nyc_output/
junit.xml

# ── Docker files (not needed inside the image) ────────────────────────────────
Dockerfile*
docker-compose*.yml
docker-entrypoint.sh
.dockerignore

# ── Documentation & non-runtime files ────────────────────────────────────────
*.md
LICENSE
docs/

# ── OS-specific ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
